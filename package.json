{
  "name": "nova",
  "version": "2.9.17",
  "description": "Nova - All-in-one productivity workspace",
  "main": "dist/main/index.js",
  "author": "GongJinCheng",
  "license": "MIT",
  "scripts": {
    "build:main": "node esbuild.main.mjs",
    "build:preload": "node esbuild.preload.mjs",
    "build:renderer": "node esbuild.renderer.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:prod": "node scripts/build-prod.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "start": "electron .",
    "dev": "npm run build && npm run start",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --win --dir",
    "publish:win": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "icon": "assets/nova-icon.png",
    "appId": "com.gongjincheng.nova",
    "productName": "Nova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "src/renderer/styles/**/*",
      "node_modules/monaco-editor/**/*",
      "package.json",
      "assets/nova-icon.png"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asar": true,
    "forceCodeSigning": false,
    "publish": [
      {
        "provider": "github",
        "owner": "GongJinCheng",
        "repo": "NovaWorkspace"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "mermaid": "^11.6.0",
    "monaco-editor": "^0.52.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.34.5"
  }
}
